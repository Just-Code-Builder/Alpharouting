# Launch radar configuration. Copy to /etc/alpharouting/radar.env
#
# The radar is read-only and holds no secrets, so this file carries nothing
# sensitive and can be 0644.

# --- Chain ---------------------------------------------------------------
# Any EVM chain. For Robinhood Chain, supply its RPC endpoint here.
RPC_URL=https://your-rpc-endpoint

# DEX factory to watch for new pools, and which event shape it emits.
# DEX_KIND=v2 -> PairCreated, DEX_KIND=v3 -> PoolCreated
DEX_FACTORY=0x0000000000000000000000000000000000000000
DEX_KIND=v2

# Quote asset used to size liquidity (WETH, USDC, whatever the chain pairs
# against). QUOTE_USD_PRICE is its price in USD — leave it unset and
# liquidity is reported as "unknown" rather than guessed.
QUOTE_TOKEN=0x0000000000000000000000000000000000000000
QUOTE_USD_PRICE=3000
QUOTE_DECIMALS=18

# Block to start from on a cold cache. The factory's deployment block avoids
# scanning pointless empty history.
START_BLOCK=0

# --- Runtime -------------------------------------------------------------
SEEN_CACHE_PATH=/var/lib/alpharouting/seen_pools.json
POLL_INTERVAL_SECS=15

# Blocks per eth_getLogs call. Lower this if the RPC provider rejects wide
# ranges (many cap at 2000-10000 blocks).
BLOCK_CHUNK=2000

# How many blocks after a pool's creation to sample swap activity over.
ACTIVITY_WINDOW_BLOCKS=5000

# --- Logging -------------------------------------------------------------
# REQUIRED for any log output. Without RUST_LOG the tracing filter defaults
# to silence, and the service looks hung when it is in fact working fine.
RUST_LOG=info
