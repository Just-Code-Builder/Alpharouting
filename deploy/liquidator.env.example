# Liquidation bot configuration. Copy to /etc/alpharouting/liquidator.env
#
# DO NOT PUT THE PRIVATE KEY IN THIS FILE.
#
# The systemd unit passes the key via LoadCredential and sets
# PRIVATE_KEY_FILE itself, so the key lives only in
# /etc/alpharouting/signing-key (root-owned, 0600) and is never exposed in
# this file, in the unit, or in the process environment.

# --- Chain ---------------------------------------------------------------
RPC_URL=https://your-rpc-endpoint

# Requires a chain where Aave V3 is actually deployed. CHAIN_ID must match
# an entry in crates/config/src/chain_spec.rs.
CHAIN_ID=8453

# Your deployed AlphaRouting contract.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Aave's AaveProtocolDataProvider for this chain.
# Base mainnet: 0xd82a47fdebB5bf5329b09441C3DaB4b5df2153Ad
AAVE_POOL_DATA_PROVIDER=0xd82a47fdebB5bf5329b09441C3DaB4b5df2153Ad

# Aave V3 Pool deployment block is the right value for a full borrower
# history; 0 works but wastes a long first scan.
DISCOVERY_START_BLOCK=0

# --- Strategy ------------------------------------------------------------
# Minimum profit, in the debt asset's smallest unit, below which the
# contract reverts the whole liquidation. 1 USDC = 1000000.
# Set this above your expected gas cost or you will pay to break even.
MIN_PROFIT=1000000

SELL_DEX=uniswap
SELL_FEE_BPS=3000

# --- Runtime -------------------------------------------------------------
BORROWER_CACHE_PATH=/var/lib/alpharouting/borrowers.json
POLL_INTERVAL_SECS=30

# --- Logging -------------------------------------------------------------
# REQUIRED for any log output — see the note in radar.env.example.
RUST_LOG=info
